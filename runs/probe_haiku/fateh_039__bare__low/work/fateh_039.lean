import Mathlib

open Polynomial
/--
Prove that a splitting field of \( X^{15} - 2 \) over \( \mathbb{F}_7 \) is generated by a
 primitive \( 45 \)-th root of unity.
-/
theorem exists_isPrimitiveRoot_and_adjoin_eq_top :
    letI : Fact (Nat.Prime 7) := by decide
    ∃ ζ : (X ^ 15 - 2 : (ZMod 7)[X]).SplittingField, IsPrimitiveRoot ζ 45 ∧
    IntermediateField.adjoin (ZMod 7) {ζ} = ⊤ := by
  have hn2 : (2 : ZMod 7) ≠ 0 := by decide
  have hn15 : ((15 : ℕ) : ZMod 7) ≠ 0 := by decide
  have hF7 : Fact (Nat.Prime 7) := ⟨by norm_num⟩
  have hpC : (X ^ 15 - 2 : (ZMod 7)[X]) = X ^ 15 - C 2 := by rw [map_ofNat C 2]
  have main : ∀ (L : Type) [Field L] [Algebra (ZMod 7) L] [Finite L] (p : (ZMod 7)[X]),
      p = X ^ 15 - 2 → IsSplittingField (ZMod 7) L p →
      ∃ ζ : L, IsPrimitiveRoot ζ 45 ∧ IntermediateField.adjoin (ZMod 7) {ζ} = ⊤ := by
    intro L _ _ _ p hpdef hsp
    subst hpdef
    classical
    haveI : CharP L 7 := charP_of_injective_algebraMap (algebraMap (ZMod 7) L).injective 7
    have h7 : (7 : L) = 0 := CharP.cast_eq_zero L 7
    have h2cube : (2 : L) ^ 3 = 1 := by linear_combination h7
    have h2ne : (2 : L) ≠ 1 := by
      intro h
      apply one_ne_zero (α := L)
      linear_combination h
    have h2ne0 : (2 : L) ≠ 0 := by
      intro h; rw [h] at h2cube; norm_num at h2cube
    have hsplit := IsSplittingField.splits L (X ^ 15 - 2 : (ZMod 7)[X])
    have hPdeg : ((X ^ 15 - 2 : (ZMod 7)[X]).map (algebraMap (ZMod 7) L)).natDegree = 15 := by
      rw [natDegree_map, hpC, natDegree_X_pow_sub_C]
    have hcard : ((X ^ 15 - 2 : (ZMod 7)[X]).map (algebraMap (ZMod 7) L)).roots.card = 15 := by
      rw [splits_iff_card_roots.mp hsplit, hPdeg]
    have hP0 : (X ^ 15 - 2 : (ZMod 7)[X]).map (algebraMap (ZMod 7) L) ≠ 0 := by
      intro h; rw [h] at hPdeg; simp at hPdeg
    have hsep : ((X ^ 15 - 2 : (ZMod 7)[X]).map (algebraMap (ZMod 7) L)).Separable := by
      apply Separable.map
      rw [hpC]
      exact separable_X_pow_sub_C (2 : ZMod 7) hn15 hn2
    have hnd := nodup_roots hsep
    have hmem : ∀ r : L, r ∈ ((X ^ 15 - 2 : (ZMod 7)[X]).map (algebraMap (ZMod 7) L)).roots ↔
        r ^ 15 = 2 := by
      intro r
      rw [mem_roots hP0]
      simp [IsRoot, eval_map, sub_eq_zero]
    obtain ⟨α, hα⟩ : ∃ α, α ∈ ((X ^ 15 - 2 : (ZMod 7)[X]).map (algebraMap (ZMod 7) L)).roots :=
      Multiset.card_pos_iff_exists_mem.mp (by rw [hcard]; norm_num)
    have hα15 : α ^ 15 = 2 := (hmem α).mp hα
    have hα0 : α ≠ 0 := by
      intro h; apply h2ne0; rw [← hα15, h]; norm_num
    -- an element r of roots with r^3 ≠ α^3
    have hex : ∃ r ∈ ((X ^ 15 - 2 : (ZMod 7)[X]).map (algebraMap (ZMod 7) L)).roots,
        r ^ 3 ≠ α ^ 3 := by
      by_contra hcon
      push_neg at hcon
      have hsub : ((X ^ 15 - 2 : (ZMod 7)[X]).map (algebraMap (ZMod 7) L)).roots ≤
          (X ^ 3 - C (α ^ 3) : L[X]).roots := by
        rw [Multiset.le_iff_subset hnd]
        intro r hr
        rw [mem_roots (X_pow_sub_C_ne_zero (by norm_num) _), IsRoot, eval_sub, eval_pow, eval_X,
          eval_C, sub_eq_zero]
        exact hcon r hr
      have h1 := Multiset.card_le_card hsub
      have h3 := card_roots' (X ^ 3 - C (α ^ 3) : L[X])
      rw [natDegree_X_pow_sub_C] at h3
      rw [hcard] at h1
      omega
    obtain ⟨r, hr, hr3⟩ := hex
    have hr15 : r ^ 15 = 2 := (hmem r).mp hr
    -- order 5 element
    have hinv : α ^ 3 * (α ^ 3)⁻¹ = 1 := mul_inv_cancel₀ (pow_ne_zero 3 hα0)
    have hy5 : (r ^ 3 * (α ^ 3)⁻¹) ^ 5 = 1 := by
      have e : (r ^ 3 * (α ^ 3)⁻¹) ^ 5 * α ^ 15 = 1 * α ^ 15 := by
        linear_combination (r ^ 15 * ((α ^ 3 * (α ^ 3)⁻¹) ^ 4 + (α ^ 3 * (α ^ 3)⁻¹) ^ 3
          + (α ^ 3 * (α ^ 3)⁻¹) ^ 2 + (α ^ 3 * (α ^ 3)⁻¹) + 1)) * hinv
          + hr15 - hα15
      exact mul_right_cancel₀ (pow_ne_zero 15 hα0) e
    have hy1 : r ^ 3 * (α ^ 3)⁻¹ ≠ 1 := by
      intro h
      exact hr3 ((mul_inv_eq_one₀ (pow_ne_zero 3 hα0)).mp h)
    haveI : Fact (Nat.Prime 5) := ⟨by norm_num⟩
    have hy_ord : orderOf (r ^ 3 * (α ^ 3)⁻¹) = 5 := orderOf_eq_prime hy5 hy1
    have hβ9 : (α ^ 5) ^ 9 = 1 := by
      rw [← pow_mul, show 5 * 9 = 15 * 3 by norm_num, pow_mul, hα15, h2cube]
    have hβ3 : (α ^ 5) ^ 3 ≠ 1 := by
      rw [← pow_mul, show 5 * 3 = 15 by norm_num, hα15]
      exact h2ne
    haveI : Fact (Nat.Prime 3) := ⟨by norm_num⟩
    have hβ_ord : orderOf (α ^ 5) = 9 := by
      have := @orderOf_eq_prime_pow L _ (α ^ 5) 1 3 _ (by norm_num [hβ3]) (by norm_num [hβ9])
      simpa using this
    have hζ : IsPrimitiveRoot (α ^ 5 * (r ^ 3 * (α ^ 3)⁻¹)) 45 := by
      rw [IsPrimitiveRoot.iff_orderOf,
        Commute.orderOf_mul_eq_mul_orderOf_of_coprime (Commute.all _ _)
          (by rw [hβ_ord, hy_ord]; norm_num), hβ_ord, hy_ord]
    refine ⟨α ^ 5 * (r ^ 3 * (α ^ 3)⁻¹), hζ, ?_⟩
    generalize α ^ 5 * (r ^ 3 * (α ^ 3)⁻¹) = ζ at hζ ⊢
    -- every element of L satisfies x^(7^12) = x
    have hpow : ∀ x : L, x ^ (7 ^ 12) = x := by
      intro x
      have hx : x ∈ Algebra.adjoin (ZMod 7) ((X ^ 15 - 2 : (ZMod 7)[X]).rootSet L) := by
        rw [IsSplittingField.adjoin_rootSet L]
        exact Algebra.mem_top
      refine Algebra.adjoin_induction (p := fun x _ => x ^ (7 ^ 12) = x) ?_ ?_ ?_ ?_ hx
      · intro y hy
        rw [mem_rootSet] at hy
        have hy15 : y ^ 15 = 2 := by
          have h := hy.2
          rw [map_sub, map_pow, aeval_X, map_ofNat, sub_eq_zero] at h
          exact h
        have h45 : y ^ 45 = 1 := by
          rw [show (45 : ℕ) = 15 * 3 from rfl, pow_mul, hy15, h2cube]
        obtain ⟨k, hk⟩ : ∃ k, 7 ^ 12 = 45 * k + 1 := ⟨(7 ^ 12 - 1) / 45, by norm_num⟩
        show y ^ (7 ^ 12) = y
        rw [hk, pow_succ, pow_mul, h45, one_pow, one_mul]
      · intro c
        show (algebraMap (ZMod 7) L c) ^ (7 ^ 12) = algebraMap (ZMod 7) L c
        rw [← map_pow, ZMod.pow_card_pow]
      · intro x y _ _ hx hy
        rw [add_pow_char_pow, hx, hy]
      · intro x y _ _ hx hy
        rw [mul_pow, hx, hy]
    -- degree bound: finrank L ≤ 12
    haveI : Fintype L := Fintype.ofFinite L
    have hcardL : Fintype.card L = 7 ^ Module.finrank (ZMod 7) L := by
      rw [Module.card_eq_pow_finrank (K := ZMod 7), ZMod.card 7]
    have hQ : (X ^ (7 ^ 12) - X : L[X]).natDegree = 7 ^ 12 :=
      FiniteField.X_pow_card_sub_X_natDegree_eq L (by norm_num)
    have hQ0 : (X ^ (7 ^ 12) - X : L[X]) ≠ 0 := by
      intro h
      rw [h, natDegree_zero] at hQ
      norm_num at hQ
    have hsubset : (Finset.univ : Finset L) ⊆ (X ^ (7 ^ 12) - X : L[X]).roots.toFinset := by
      intro x _
      rw [Multiset.mem_toFinset, mem_roots hQ0, IsRoot, eval_sub, eval_pow, eval_X, hpow x,
        sub_self]
    have hle : Fintype.card L ≤ 7 ^ 12 := by
      rw [← Finset.card_univ]
      calc (Finset.univ : Finset L).card
          ≤ (X ^ (7 ^ 12) - X : L[X]).roots.toFinset.card := Finset.card_le_card hsubset
        _ ≤ (X ^ (7 ^ 12) - X : L[X]).roots.card := Multiset.toFinset_card_le _
        _ ≤ (X ^ (7 ^ 12) - X : L[X]).natDegree := card_roots' _
        _ = 7 ^ 12 := hQ
    have hnle : Module.finrank (ZMod 7) L ≤ 12 := by
      rw [hcardL] at hle
      exact (Nat.pow_le_pow_iff_right (by norm_num)).mp hle
    -- the subfield generated by ζ
    have hζF : ζ ∈ IntermediateField.adjoin (ZMod 7) {ζ} :=
      IntermediateField.subset_adjoin (ZMod 7) {ζ} (Set.mem_singleton ζ)
    haveI : Fintype (IntermediateField.adjoin (ZMod 7) {ζ}) := Fintype.ofFinite _
    have hcardF : Fintype.card (IntermediateField.adjoin (ZMod 7) {ζ}) =
        7 ^ Module.finrank (ZMod 7) (IntermediateField.adjoin (ZMod 7) {ζ}) := by
      rw [Module.card_eq_pow_finrank (K := ZMod 7), ZMod.card 7]
    have hle2 : Fintype.card (IntermediateField.adjoin (ZMod 7) {ζ}) ≤ Fintype.card L :=
      Fintype.card_le_of_injective (fun x : IntermediateField.adjoin (ZMod 7) {ζ} => (x : L))
        (fun a b h => Subtype.ext h)
    have hmn : Module.finrank (ZMod 7) (IntermediateField.adjoin (ZMod 7) {ζ}) ≤
        Module.finrank (ZMod 7) L := by
      rw [hcardF, hcardL] at hle2
      exact (Nat.pow_le_pow_iff_right (by norm_num)).mp hle2
    have hm1 : 1 < Fintype.card (IntermediateField.adjoin (ZMod 7) {ζ}) :=
      Fintype.one_lt_card
    have hm0 : Module.finrank (ZMod 7) (IntermediateField.adjoin (ZMod 7) {ζ}) ≠ 0 := by
      intro h
      rw [hcardF, h, pow_zero] at hm1
      exact lt_irrefl _ hm1
    have hpowF : (⟨ζ, hζF⟩ : IntermediateField.adjoin (ZMod 7) {ζ}) ^
        Fintype.card (IntermediateField.adjoin (ZMod 7) {ζ}) = ⟨ζ, hζF⟩ :=
      FiniteField.pow_card _
    have hζpow : ζ ^ (7 ^ Module.finrank (ZMod 7) (IntermediateField.adjoin (ZMod 7) {ζ})) = ζ := by
      have h := congrArg Subtype.val hpowF
      rw [hcardF] at h
      simpa using h
    have hz0 : ζ ≠ 0 := hζ.ne_zero (by norm_num)
    have hpow1 : ζ ^ (7 ^ Module.finrank (ZMod 7) (IntermediateField.adjoin (ZMod 7) {ζ}) - 1)
        = 1 := by
      have hge : 1 ≤ 7 ^ Module.finrank (ZMod 7) (IntermediateField.adjoin (ZMod 7) {ζ}) :=
        Nat.one_le_pow _ _ (by norm_num)
      have e : ζ ^ (7 ^ Module.finrank (ZMod 7) (IntermediateField.adjoin (ZMod 7) {ζ}) - 1)
          * ζ = 1 * ζ := by
        rw [one_mul, ← pow_succ, Nat.sub_add_cancel hge, hζpow]
      exact mul_right_cancel₀ hz0 e
    have hdvd : 45 ∣ 7 ^ Module.finrank (ZMod 7) (IntermediateField.adjoin (ZMod 7) {ζ}) - 1 :=
      (hζ.pow_eq_one_iff_dvd _).mp hpow1
    have key : ∀ j : ℕ, 7 ^ j % 45 = 7 ^ (j % 12) % 45 := by
      intro j
      conv_lhs => rw [← Nat.div_add_mod j 12, pow_add, pow_mul]
      rw [Nat.mul_mod, Nat.pow_mod]
      norm_num
    have hm12 : 12 ∣ Module.finrank (ZMod 7) (IntermediateField.adjoin (ZMod 7) {ζ}) := by
      have h1 := key (Module.finrank (ZMod 7) (IntermediateField.adjoin (ZMod 7) {ζ}))
      have hge : 1 ≤ 7 ^ Module.finrank (ZMod 7) (IntermediateField.adjoin (ZMod 7) {ζ}) :=
        Nat.one_le_pow _ _ (by norm_num)
      have h2 : 7 ^ Module.finrank (ZMod 7) (IntermediateField.adjoin (ZMod 7) {ζ}) % 45 = 1 := by
        omega
      have hlt : Module.finrank (ZMod 7) (IntermediateField.adjoin (ZMod 7) {ζ}) % 12 < 12 :=
        Nat.mod_lt _ (by norm_num)
      apply Nat.dvd_of_mod_eq_zero
      generalize Module.finrank (ZMod 7) (IntermediateField.adjoin (ZMod 7) {ζ}) % 12 = s at h1 hlt ⊢
      interval_cases s <;> norm_num at h1 <;> omega
    have hpos := Nat.pos_of_ne_zero hm0
    have hm12' := Nat.le_of_dvd hpos hm12
    have hfin_eq : Module.finrank (ZMod 7) (IntermediateField.adjoin (ZMod 7) {ζ}) =
        Module.finrank (ZMod 7) L := by
      omega
    haveI : FiniteDimensional (ZMod 7) L := inferInstance
    apply IntermediateField.eq_of_le_of_finrank_eq le_top
    rw [IntermediateField.finrank_top']
    exact hfin_eq
  exact main _ _ rfl inferInstance
