import Mathlib

namespace Problem20

/--
Let $p$ be a prime number. Let $L/K$ be a finite extension of fields of characteristic $p$,
and let $\sigma:x\mapsto x^p$ denote the $p$-Frobenius endomorphism on $L$, which of course
stabilizes $K$. Prove that if $[L:K\sigma(L)] \leq p$, then $L/K$ can be generated by one element.
-/
theorem generated_single_elem_of_degree_le_p (p : ℕ) [Fact (Nat.Prime p)]
    (K L : Type) [Field K] [Field L] [CharP L p] [Algebra K L] [FiniteDimensional K L]
    (h : Module.rank (IntermediateField.adjoin K ((frobenius L p).range : Set L)) L ≤ p) :
    ∃ (x : L), IntermediateField.adjoin K {x} = ⊤ := by
  open Polynomial IntermediateField in
  (
    classical
    haveI : ExpChar L p := ExpChar.prime (Fact.out)
    by_cases hK : Finite K
    · haveI : Finite L := Module.finite_of_finite K
      exact Field.exists_primitive_element_of_finite_top K L
    haveI : Infinite K := not_finite_iff_infinite.1 hK
    have twogen : ∀ (α β : L), IsIntegral K α → IsSeparable K β → ∃ γ : L, K⟮α, β⟯ = K⟮γ⟯ := by
      intro α β hα hβ
      have hβi : IsIntegral K β := hβ.isIntegral
      set f := minpoly K α with hf
      set g := minpoly K β with hg
      have hf0 : f ≠ 0 := minpoly.ne_zero hα
      have hg0 : g ≠ 0 := minpoly.ne_zero hβi
      let Ω := SplittingField ((f * g).map (algebraMap K L))
      let ϕ : K →+* Ω := (algebraMap L Ω).comp (algebraMap K L)
      let α' : Ω := algebraMap L Ω α
      let β' : Ω := algebraMap L Ω β
      obtain ⟨c, hc⟩ := Field.primitive_element_inf_aux_exists_c ϕ α' β' f g
      have hsplit : ((f * g).map ϕ).Splits := by
        have := IsSplittingField.splits Ω ((f * g).map (algebraMap K L))
        rwa [Polynomial.map_map] at this
      have hfg0 : (f * g).map ϕ ≠ 0 := by
        simpa using mul_ne_zero hf0 hg0
      have hgs : (g.map ϕ).Splits :=
        Splits.of_dvd hsplit hfg0 (by simpa using Polynomial.map_dvd ϕ (dvd_mul_left g f))
      set γ : L := α + algebraMap K L c * β with hγ
      have key : β ∈ K⟮γ⟯ := by
        set E := K⟮γ⟯ with hE
        let γE : E := ⟨γ, mem_adjoin_simple_self K γ⟩
        let m := minpoly E β
        let ψ : E →+* Ω := (algebraMap L Ω).comp (E.val : E →+* L)
        have hψ : ψ.comp (algebraMap K E) = ϕ := by ext x; rfl
        have hmg : m ∣ g.map (algebraMap K E) := minpoly.dvd_map_of_isScalarTower K E β
        let h : E[X] := (f.map (algebraMap K E)).comp (C γE - C (algebraMap K E c) * X)
        have hmh : m ∣ h := by
          apply minpoly.dvd
          have : aeval β (C γE - C (algebraMap K E c) * X) = α := by
            simp [γE, hγ]
          simp only [h, aeval_comp, this]
          rw [aeval_map_algebraMap]
          exact minpoly.aeval K α
        have hmi : IsIntegral E β := hβi.tower_top
        have hm0 : m.map ψ ≠ 0 := by
          have := minpoly.ne_zero hmi
          simpa using this
        have h1 : m.map ψ ∣ g.map ϕ := by
          have := Polynomial.map_dvd ψ hmg
          rwa [Polynomial.map_map, hψ] at this
        have h2 : m.map ψ ∣ h.map ψ := Polynomial.map_dvd ψ hmh
        have hsp : (m.map ψ).Splits := Splits.of_dvd hgs (by simpa using hg0) h1
        have hsep : (m.map ψ).Separable := by
          have : (g.map ϕ).Separable := (show g.Separable from hβ).map
          exact this.of_dvd h1
        have hall : ∀ r ∈ (m.map ψ).roots, r = β' := by
          intro r hr
          have hr' : (m.map ψ).IsRoot r := (mem_roots hm0).1 hr
          have hrg : (g.map ϕ).IsRoot r := by
            obtain ⟨q, hq⟩ := h1
            simp [hq, hr'.eq_zero]
          have hrh : (h.map ψ).IsRoot r := by
            obtain ⟨q, hq⟩ := h2
            simp [hq, hr'.eq_zero]
          by_contra hne
          have hf0' : f.map ϕ ≠ 0 := by simpa using hf0
          have hroot : (f.map ϕ).IsRoot (algebraMap L Ω γ - ϕ c * r) := by
            have := hrh
            simp only [h, Polynomial.map_comp, Polynomial.map_map, hψ, IsRoot.def, eval_comp] at this
            simpa [ψ, γE, ϕ] using this
          have hm := hc _ ((mem_roots hf0').2 hroot) r ((mem_roots (by simpa using hg0)).2 hrg)
          apply hm
          have hsub : r - β' ≠ 0 := sub_ne_zero.2 hne
          have : algebraMap L Ω γ = α' + ϕ c * β' := by
            simp [hγ, α', β', ϕ]
          rw [this]
          rw [div_eq_iff hsub]
          ring
        have hcard : (m.map ψ).roots.card ≤ 1 := by
          have h3 : (m.map ψ).roots = Multiset.replicate (m.map ψ).roots.card β' :=
            (Multiset.eq_replicate.2 ⟨rfl, hall⟩)
          have hnd := Polynomial.nodup_roots hsep
          have hnd2 : (Multiset.replicate (m.map ψ).roots.card β').Nodup := by
            rw [← h3]; exact hnd
          exact List.nodup_replicate.mp hnd2
        have hdeg : m.natDegree = 1 := by
          have h4 := hsp.natDegree_eq_card_roots
          rw [Polynomial.natDegree_map] at h4
          have hpos : 0 < m.natDegree := minpoly.natDegree_pos hmi
          omega
        obtain ⟨e, he⟩ := minpoly.natDegree_eq_one_iff.1 hdeg
        rw [← he]; exact e.2
      refine ⟨γ, le_antisymm ?_ ?_⟩
      · rw [adjoin_le_iff]
        intro x hx
        rcases hx with h | h
        · have : α = γ - algebraMap K L c * β := by rw [hγ]; ring
          rw [h, this]
          exact sub_mem (mem_adjoin_simple_self K γ) (mul_mem (IntermediateField.algebraMap_mem _ _) key)
        · rw [Set.mem_singleton_iff.1 h]; exact key
      · rw [adjoin_simple_le_iff]
        exact add_mem (subset_adjoin K _ (by simp)) (mul_mem (IntermediateField.algebraMap_mem _ _) (subset_adjoin K _ (by simp)))
    set F := IntermediateField.adjoin K ((frobenius L p).range : Set L) with hFdef
    have hFp : ∀ y : L, y ^ p ∈ F := fun y =>
      subset_adjoin K _ ⟨y, rfl⟩
    have hfr : Module.finrank F L ≤ p := by
      have h2 : (Module.finrank F L : Cardinal) ≤ p := by rw [Module.finrank_eq_rank]; exact h
      exact_mod_cast h2
    haveI : CharP F p := (RingHom.charP_iff (F.val : F →+* L) (F.val : F →+* L).injective p).2 inferInstance
    haveI : ExpChar F p := ExpChar.prime (Fact.out)
    haveI : IsPurelyInseparable F L := by
      rw [isPurelyInseparable_iff_pow_mem F p]
      intro x
      exact ⟨1, by simpa using hFp x⟩
    -- Step B
    have hB : ∃ a : L, ∀ E : IntermediateField K L, F ≤ E → a ∈ E → E = ⊤ := by
      by_cases hFt : F = ⊤
      · exact ⟨0, fun E hE _ => top_le_iff.1 (hFt ▸ hE)⟩
      obtain ⟨a, haF⟩ : ∃ a : L, a ∉ F := by
        by_contra hcon
        push_neg at hcon
        exact hFt (top_le_iff.1 fun x _ => hcon x)
      have hadj : F⟮a⟯ = ⊤ := by
        obtain ⟨m, y, hm⟩ := IsPurelyInseparable.minpoly_eq_X_pow_sub_C F p a
        have hdeg : (minpoly F a).natDegree = p ^ m := by
          rw [hm]; exact natDegree_X_pow_sub_C
        have hm1 : m ≠ 0 := by
          rintro rfl
          have : (minpoly F a).natDegree = 1 := by simpa using hdeg
          obtain ⟨e, he⟩ := minpoly.natDegree_eq_one_iff.1 this
          exact haF (he ▸ e.2)
        have hp : p ≤ p ^ m := by
          calc p = p ^ 1 := (pow_one p).symm
            _ ≤ p ^ m := Nat.pow_le_pow_right (Fact.out : p.Prime).pos (Nat.one_le_iff_ne_zero.2 hm1)
        have hfin : Module.finrank F F⟮a⟯ = p ^ m := by
          rw [IntermediateField.adjoin.finrank (IsIntegral.of_finite F a), hdeg]
        apply IntermediateField.eq_of_le_of_finrank_le le_top
        rw [hfin, IntermediateField.finrank_top']
        omega
      refine ⟨a, fun E hFE haE => ?_⟩
      have : F⟮a⟯ ≤ IntermediateField.extendScalars hFE := by
        rw [adjoin_simple_le_iff]; exact haE
      rw [hadj] at this
      apply top_le_iff.1
      intro x _
      exact (mem_extendScalars (hFE)).1 (this (mem_top))
    obtain ⟨a, ha⟩ := hB
    -- Step C
    set S := separableClosure K L with hS
    haveI : CharP S p := (RingHom.charP_iff (S.val : S →+* L) (S.val : S →+* L).injective p).2 inferInstance
    haveI : ExpChar S p := ExpChar.prime (Fact.out)
    haveI : IsPurelyInseparable S L := separableClosure.isPurelyInseparable K L
    have hC : ∃ n : ℕ, ∀ x : L, x ^ p ^ n ∈ S := by
      refine ⟨Module.finrank S L, fun x => ?_⟩
      obtain ⟨m, y, hm⟩ := IsPurelyInseparable.minpoly_eq_X_pow_sub_C S p x
      have hdeg : (minpoly S x).natDegree = p ^ m := by
        rw [hm]; exact natDegree_X_pow_sub_C
      have hle : p ^ m ≤ Module.finrank S L := hdeg ▸ minpoly.natDegree_le x
      have hmlt : m < p ^ m := Nat.lt_pow_self (Fact.out : p.Prime).one_lt
      have hmd : m ≤ Module.finrank S L := by omega
      have hx : x ^ p ^ m = algebraMap S L y := by
        have := minpoly.aeval S x
        rw [hm] at this
        simp at this
        exact sub_eq_zero.1 this
      have : x ^ p ^ Module.finrank S L = (x ^ p ^ m) ^ p ^ (Module.finrank S L - m) := by
        rw [← pow_mul, ← pow_add, Nat.add_sub_cancel' hmd]
      rw [this, hx]
      exact pow_mem (y.2) _
    obtain ⟨n, hn⟩ := hC
    -- Step D
    let M : IntermediateField K L := K⟮a⟯
    let E : ℕ → IntermediateField K L := fun j =>
      M ⊔ IntermediateField.adjoin K (Set.range (fun x : L => x ^ p ^ j))
    have hE : ∀ j, E j = ⊤ := by
      intro j
      induction j with
      | zero =>
        apply top_le_iff.1
        intro x _
        apply (le_sup_right : _ ≤ E 0)
        exact subset_adjoin K _ ⟨x, by simp⟩
      | succ j ih =>
        let Q := E (j + 1)
        let PQ : IntermediateField K L :=
          { carrier := {x | x ^ p ∈ Q}
            mul_mem' := fun {a b} ha hb => by
              simp only [Set.mem_setOf_eq, mul_pow]; exact mul_mem ha hb
            one_mem' := by simp
            add_mem' := fun {a b} ha hb => by
              simp only [Set.mem_setOf_eq, add_pow_char]; exact add_mem ha hb
            zero_mem' := by
              simp only [Set.mem_setOf_eq]
              rw [zero_pow (Fact.out : p.Prime).ne_zero]; exact zero_mem _
            algebraMap_mem' := fun k => by
              simp only [Set.mem_setOf_eq, ← map_pow]; exact IntermediateField.algebraMap_mem Q _
            inv_mem' := fun x hx => by
              simp only [Set.mem_setOf_eq, inv_pow] at hx ⊢; exact inv_mem hx }
        have hMQ : M ≤ Q := le_sup_left
        have hle : E j ≤ PQ := by
          apply sup_le
          · intro x hx
            exact hMQ (pow_mem hx p)
          · rw [adjoin_le_iff]
            rintro x ⟨y, rfl⟩
            show (y ^ p ^ j) ^ p ∈ Q
            rw [← pow_mul, ← pow_succ]
            exact (le_sup_right : IntermediateField.adjoin K (Set.range (fun x : L => x ^ p ^ (j+1))) ≤ Q) (subset_adjoin K _ ⟨y, rfl⟩)
        have hall : ∀ x : L, x ^ p ∈ Q := fun x => hle (ih ▸ mem_top)
        apply ha Q
        · rw [hFdef, adjoin_le_iff]
          rintro x ⟨y, rfl⟩
          exact hall y
        · exact hMQ (mem_adjoin_simple_self K a)
    -- Step E
    haveI : Algebra.IsSeparable K S := separableClosure.isSeparable K L
    obtain ⟨c', hc'⟩ := Field.exists_primitive_element K S
    have hcsep : IsSeparable K (c' : L) := (mem_separableClosure_iff).1 c'.2
    have hSle : S ≤ K⟮(c' : L)⟯ := by
      intro s hs
      have h1 : (⟨s, hs⟩ : S) ∈ K⟮c'⟯ := by rw [hc']; exact mem_top
      have h2 : (⟨s, hs⟩ : S).1 ∈ (K⟮c'⟯).map S.val := ⟨_, h1, rfl⟩
      rw [IntermediateField.adjoin_map] at h2
      simpa using h2
    obtain ⟨γ, hγ⟩ := twogen a (c' : L) (IsIntegral.of_finite K a) hcsep
    refine ⟨γ, ?_⟩
    rw [← hγ]
    apply top_le_iff.1
    rw [← hE n]
    apply sup_le
    · rw [adjoin_simple_le_iff]
      exact subset_adjoin K _ (by simp)
    · rw [adjoin_le_iff]
      rintro x ⟨y, rfl⟩
      exact (adjoin.mono K _ _ (by simp : ({(c' : L)} : Set L) ⊆ {a, (c' : L)})) (hSle (hn y))
  )

end Problem20
