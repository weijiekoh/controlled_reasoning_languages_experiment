import Mathlib

open Polynomial
/--
Prove that a splitting field of \( X^{15} - 2 \) over \( \mathbb{F}_7 \) is generated by a
 primitive \( 45 \)-th root of unity.
-/
theorem exists_isPrimitiveRoot_and_adjoin_eq_top :
    letI : Fact (Nat.Prime 7) := by decide
    ∃ ζ : (X ^ 15 - 2 : (ZMod 7)[X]).SplittingField, IsPrimitiveRoot ζ 45 ∧
    IntermediateField.adjoin (ZMod 7) {ζ} = ⊤ := by
  haveI hp7 : Fact (Nat.Prime 7) := ⟨by norm_num⟩
  have h2_7 : (2 : ZMod 7) ≠ 0 := by decide
  have h1_7 : (2 : ZMod 7) ≠ 1 := by decide
  have h8_7 : (2 : ZMod 7) ^ 3 = 1 := by decide
  have hpoly : (X ^ 15 - 2 : (ZMod 7)[X]) = X ^ 15 - C 2 := by simp [map_ofNat]
  have hsep : (X ^ 15 - 2 : (ZMod 7)[X]).Separable := by
    have h := separable_X_pow_sub_C (F := ZMod 7) (n := 15) (2 : ZMod 7) (by decide) h2_7
    rw [hpoly]; exact h
  have hdeg : (X ^ 15 - 2 : (ZMod 7)[X]).natDegree = 15 := by
    rw [hpoly]; exact natDegree_X_pow_sub_C
  have hf0 : (X ^ 15 - 2 : (ZMod 7)[X]) ≠ 0 := by
    intro h; rw [h] at hdeg; simp at hdeg
  have hcard : Fintype.card ((X ^ 15 - 2 : (ZMod 7)[X]).rootSet
      (X ^ 15 - 2 : (ZMod 7)[X]).SplittingField) = 15 := by
    rw [card_rootSet_eq_natDegree hsep (SplittingField.splits _), hdeg]
  have hroot : ∀ x ∈ (X ^ 15 - 2 : (ZMod 7)[X]).rootSet
      (X ^ 15 - 2 : (ZMod 7)[X]).SplittingField, x ^ 15 = 2 := by
    intro x hx
    rw [mem_rootSet_of_ne hf0] at hx
    simpa [sub_eq_zero, map_ofNat] using hx
  -- powers of 2 in the splitting field
  have hK2 : ∀ n : ℕ, ((2 : (X ^ 15 - 2 : (ZMod 7)[X]).SplittingField)) ^ n
      = algebraMap (ZMod 7) _ ((2 : ZMod 7) ^ n) := by
    intro n; rw [map_pow, map_ofNat]
  have h2K : (2 : (X ^ 15 - 2 : (ZMod 7)[X]).SplittingField) ≠ 0 := by
    intro h
    have : algebraMap (ZMod 7) _ (2 : ZMod 7) = algebraMap (ZMod 7) _ 0 := by
      rw [map_ofNat, map_zero, h]
    exact h2_7 ((algebraMap (ZMod 7) _).injective this)
  have h8K : (2 : (X ^ 15 - 2 : (ZMod 7)[X]).SplittingField) ^ 3 = 1 := by
    rw [hK2, h8_7, map_one]
  have h1K : (2 : (X ^ 15 - 2 : (ZMod 7)[X]).SplittingField) ≠ 1 := by
    intro h
    have : algebraMap (ZMod 7) _ (2 : ZMod 7) = algebraMap (ZMod 7) _ 1 := by
      rw [map_ofNat, map_one, h]
    exact h1_7 ((algebraMap (ZMod 7) _).injective this)
  obtain ⟨⟨x0, hx0⟩⟩ : Nonempty ((X ^ 15 - 2 : (ZMod 7)[X]).rootSet
      (X ^ 15 - 2 : (ZMod 7)[X]).SplittingField) :=
    Fintype.card_pos_iff.mp (by rw [hcard]; norm_num)
  have hx0p : x0 ^ 15 = 2 := hroot x0 hx0
  have hx0ne : x0 ≠ 0 := by
    intro h
    rw [h, zero_pow (by norm_num)] at hx0p
    exact h2K hx0p.symm
  sorry
